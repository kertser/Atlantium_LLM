    def get_public_fact(self, category: str, subcategory: str = None) -> Any:
        """Get a public fact from the knowledge base."""
        if not self._facts:
            return None

        if subcategory:
            return self._facts.get(category, {}).get(subcategory)
        return self._facts.get(category)

